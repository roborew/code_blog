<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Code Blog" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <style>
      .turbo-progress-bar {
        background: linear-gradient(to right, #4F46E5, #818CF8);
      }
    </style>

    <meta name="turbo-cache-control" content="no-preview">
  </head>
  <body class="bg-gray-100" data-controller="turbo">
    <header class="bg-white shadow">
      <%= render "shared/header" %>
    </header>
    <main class="w-full mx-auto px-4 sm:px-6 lg:px-8 py-8" data-controller="turbo">
      <div class="transition-opacity duration-300" data-turbo-target="temporary">
        <!-- Mobile menu button -->
        <button class="lg:hidden w-full mb-4 p-2 bg-white rounded-lg shadow text-left" onclick="document.getElementById('sidebar').classList.toggle('hidden')">
          Toggle Sidebar
        </button>
        <div class="max-w-8xl mx-auto flex flex-col lg:flex-row gap-8 justify-center">
          <!-- Sidebar -->
          <% if controller_name == 'articles' && action_name == 'index' %>
            <aside id="sidebar" class="hidden lg:block lg:w-64 bg-white p-4 shadow rounded-lg shrink-0">
              <%= render "shared/sidebar" %>
            </aside>
          <% end %>
          <!-- Main content -->
          <section class="flex-grow rounded-lg space-y-6">
            <%= render "shared/flash_notices" %>
            <%= yield %>
          </section>
        </div>
        <%#= console if Rails.env.development? %>
      </div>
      <div class="hidden items-center justify-center py-12" data-turbo-target="loading">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500"></div>
      </div>
    </main>
  </body>
</html>
