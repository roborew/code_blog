<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Code Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="bg-gray-100">
    <header class="bg-white shadow">
        <div class="w-full mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
            <h1 class="text-xl font-bold">Robins Blog</h1>
            <nav>
                <ul class="flex space-x-4">
                    <li><%= link_to "Home", root_path %></li>
                    <%= render "shared/nav_pages" %>
                    <% if user_signed_in? %>
                        <li><%= link_to "Profile", edit_user_registration_path %></li>
                        <li><%= link_to "Create New Article", new_article_path %></li>
                        <li><%= button_to "Log Out", destroy_user_session_path, method: :delete %></li>
                    <% else %>
                        <li><%= link_to "Log In", new_user_session_path %></li>
                        <li><%= link_to "Sign Up", new_user_registration_path %></li>
                    <% end %>
                </ul>
            </nav>
        </div>
    </header>

    <main class="w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Mobile menu button -->
        <button class="lg:hidden w-full mb-4 p-2 bg-white rounded-lg shadow text-left" onclick="document.getElementById('sidebar').classList.toggle('hidden')">
            Toggle Sidebar
        </button>

        <div class="max-w-full mx-auto flex flex-col lg:flex-row gap-8 justify-center">
        
                <!-- Sidebar -->
            <aside id="sidebar" class="hidden lg:block lg:w-64 bg-white p-4 shadow rounded-lg shrink-0">
                <%# <img src="https://via.placeholder.com/150" alt="Profile" class="rounded-full mb-4"> %>
                <p class="text-gray-700 mb-4">Denali is a simple responsive blog template. Easily add new posts using the Editor or change layout and design using the Designer.</p>
                <h2 class="font-bold mb-2">Featured Posts:</h2>
                <ul class="text-gray-600">
                    <li>According a funnily until preset or arrogant well cheerful</li>
                    <li>Overlaid the jeepers uselessly much excluding</li>
                </ul>
                <div class="flex space-x-2 mt-4">
                    <a href="#" class="text-gray-500 hover:text-blue-500"><i class="fab fa-facebook"></i></a>
                    <a href="#" class="text-gray-500 hover:text-blue-500"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="text-gray-500 hover:text-blue-500"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="text-gray-500 hover:text-blue-500"><i class="fab fa-linkedin"></i></a>
                </div>
            </aside>

             <!-- Main content -->
            <section class="flex-grow max-w-7xl rounded-lg space-y-6 ">
                  <%= render "shared/flash_notices" %>
                <%= yield %>
            </section>
        </div>
        <%= console if Rails.env.development? %>
    </main>
</body>
</html>
