<%= form_with(model: article) do |form| %>
  <% if article.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(article.errors.count, "error") %> prohibited this article from being saved:</h2>

      <ul>
        <% article.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div class="field" data-controller="tags" data-tags-article-value="<%= @existing_tags %>">
    <%= form.label :tags, "Tags" %>
    <input name="tags" id="tags-input" data-tags-target="tags">
  </div>

  <div>
    <%= form.label :content, style: "display: block" %>    
    <div class="content-editor-wrapper">
      <div data-controller="milkdown">
        <%= form.hidden_field :content, data: { milkdown_target: "content" } %>
        <div data-milkdown-target="editor" class="milkdown-wrapper"></div>
      </div>
    </div>
  </d>

  <div>
    <%= form.label :publication_date, style: "display: block" %>
    <%= form.datetime_field :publication_date %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
<div id="editor"></div>