<%= form_with(model: article) do |form| %>
  <% if article.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(article.errors.count, "error") %> prohibited this article from being saved:</h2>

      <ul>
        <% article.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

    <% if article.cover_image.present? %>
      <div id="<%= dom_id(article, :cover_image) %>">
        <%= image_tag article.cover_image, alt: "Cover Image", size: 200 %>
        <%= link_to "Remove cover image", article_cover_image_path(article), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    </div>
  <% end %>
  <div>
    <%= form.label :cover_image, style: "display: block" %>
    <%= form.file_field :cover_image %>
  </div>

  <div class="field" data-controller="categories" data-categories-article-value="<%= @existing_category %>">
    <%= form.label :categories, "Category" %>
    <input name="category" id="categories-input" data-categories-target="categories">
  </div>

  <div class="field" data-controller="tags" data-tags-article-value="<%= @existing_tags %>">
    <%= form.label :tags, "Tags" %>
    <input name="tags" id="tags-input" data-tags-target="tags">
  </div>

  <div>
    <%= form.label :content, style: "display: block" %>    
    <div class="content-editor-wrapper">
      <div data-controller="milkdown">
        <%= form.hidden_field :content, data: { milkdown_target: "content" } %>
        <div data-milkdown-target="editor" class="milkdown-wrapper"></div>
      </div>
    </div>
  </d>

  <div>
    <%= form.label :publication_date, style: "display: block" %>
    <%= form.datetime_field :publication_date, value: Time.now %>
  </div>

  <div>
    <label style="display: block" for="article_status">Status</label>
    <%= form.select :status, 
                   Article::STATUSES.map { |status| [status.capitalize, status] },
                   { selected: article.status.presence || "Draft" },
                   { class: "form-select" } %>
  </div>
  <div>
    <%= form.submit %>
  </div>
<% end %>
<div id="editor"></div>