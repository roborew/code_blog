<%= form_with(model: article) do |form| %>
  <% if article.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(article.errors.count, "error") %> prohibited this article from being saved:</h2>

      <ul>
        <% article.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>
<div>
    <h1 class="font-bold text-4xl text-blue-500">Public#index</h1>
    <p>Find me in app/views/public/index.html.erb</p>
  <p data-controller="hello" data-action="click->hello#handleClick"></p>
  </div>

  <div class="field" data-controller="tags">
       <%= form.label :tags, "Tags" %>
       <input name="tags" id="tags-input"  data-tags-target="tagsInput" data-action="keyup->tags#handleKeyUp">
  </div>

  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.label :publication_date, style: "display: block" %>
    <%= form.datetime_field :publication_date %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
