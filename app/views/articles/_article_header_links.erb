
<nav class="flex justify-between items-center w-full px-8 py-2 mb-4 bg-white shadow-sm border-b border-gray-200">
  <div>
    <%= link_to "<- Back to articles", articles_path, class: "text-grey-600 hover:text-blue-800" %>
  </div>
  <div class="flex items-center space-x-4">
    <% if local_assigns[:current_page] == 'show' %>
      <%= link_to "Edit this article", edit_article_path(@article), class: "text-grey-600 hover:text-blue-800" %>
    <% elsif local_assigns[:current_page] == 'edit' %>
      <%= link_to "Show this article", @article, class: "text-grey-600 hover:text-blue-800" %>
    <% end %> 
    <span class="text-gray-300 px-1">|</span>
     <%= button_to "Destroy this article", @article, 
              method: :delete, 
              class: "text-red-600 hover:text-grey-600",
              data: { turbo_confirm: "Are you sure you want to delete this article?" } %>
  </div>
</nav>
