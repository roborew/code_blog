<nav class="flex justify-between items-center gap-4 border-b pb-8 mb-4">
    <%= link_to "<- Back to articles", articles_path, class: "text-gray-600 hover:text-gray-800" %>
    <div class="ml-auto flex gap-4">
      <% if user_signed_in? %>
        <% if local_assigns[:current_page] == 'show' %>
          <%= link_to "Edit this article", edit_article_path(@article), class: "text-blue-600 hover:text-blue-800" %>
        <% elsif local_assigns[:current_page] == 'edit' %>
          <%= link_to "Show this article", @article, class: "text-blue-600 hover:text-blue-800" %>
        <% end %> 
        <%= button_to "Destroy this article", @article, 
              method: :delete, 
              class: "text-red-600 hover:text-red-800",
              data: { turbo_confirm: "Are you sure you want to delete this article?" } %>
      <% end %>
    </div>
  </nav>
