
<article class="bg-white p-4 shadow rounded-lg flex max-h-75" id="<%= dom_id article %>">
   <div class="w-1/4 flex-shrink-0 mr-5">
       <% if article.cover_image.present? %>
           <%= link_to article do %>
               <%= image_tag article.cover_image.representation(resize_to_fill: [250, 250]), alt: "Cover Image", class: "w-250 h-250 rounded-lg m-0" %>
           <% end %>
       <% else %>
           <%= link_to article do %>
               <%= image_tag "placeholder_image.webp", alt: "Default Cover Image", class: "w-full rounded-lg m-0", style: "max-width: 250px; max-height: 250px;" %>
           <% end %>
       <% end %>
   </div>
   <div>
       <h2 class="font-bold text-lg"><%= link_to article.title, article %></h2>
       <% if article.subheading.present? %>
         <h3><%= article.subheading %></h3>
       <% end %>
       <p class="text-gray-500 text-sm mb-2">
           <%= article.publication_date&.strftime("%B %d, %Y") %> 
           <% if article.category %> 
           | <%= article.category.name %>
           <% end %>
       </p>
       <p class="text-gray-700"><%= article.abstract %>
        <%= link_to "Show this article", article, class: "text-blue-500" %>
   </div>
</article> 