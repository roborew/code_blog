<article class="bg-white p-4 shadow rounded-lg">

<%= render "shared/resource_header_links", 
          resource_name: "page", 
          resource: @page, 
          current_page: 'edit' %>

  <div class="w-full">
    <% content_for :title, "Editing: #{@page.title}" %>
    <h1 class="text-2xl font-bold mb-4">Editing: <%= @page.title %></h1>
    <%= render "form", page: @page %>
  </div>
</article>


