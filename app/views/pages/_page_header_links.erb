<nav class="flex justify-between items-center w-full px-8 py-2 mb-4 bg-white shadow-sm border-b border-gray-200">
  <div>
    <%= link_to "<- Back to pages", pages_path, class: "text-grey-600 hover:text-blue-800" %>
  </div>
  <div class="flex items-center space-x-4">
    <% if local_assigns[:current_page] == 'show' %>
      <%= link_to "Edit this page", edit_page_path(@page), class: "text-grey-600 hover:text-blue-800" %>
    <% elsif local_assigns[:current_page] == 'edit' %>
      <%= button_to "Show this page", @page, 
                    method: :get, 
                    class: "text-grey-600 hover:text-blue-800", 
                    data: { turbo_confirm: "You may lose changes" } %>
    <% end %> 
    <span class="text-gray-300 px-1">|</span>
     <%= button_to "Destroy this page", @page, 
              method: :delete, 
              class: "text-red-600 hover:text-grey-600",
              data: { turbo_confirm: "Are you sure you want to delete this page?" } %>
  </div>
</nav>